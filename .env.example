# VERTEX DSA Pattern Mastery Tracker — Environment Configuration Template
# Copy this file to .env.local for local development with the local Supabase stack.
# IMPORTANT: Use ONLY the public anon key. NEVER put the service_role key here.

# Local Supabase Gateway URL (default local Kong port: 54321)
# For hosted cloud sync, replace both values with the VERTEX Supabase project URL
# and its public publishable key from Project Settings > API Keys.
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Public anon/publishable key only. NEVER put a service_role or secret key here.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Hosted project example (uncomment and replace with your project values):
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_<your-public-key>

